{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the ENT-Care desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "sql:default",
    "sql:allow-execute",
    "stronghold:default",
    "stronghold:allow-remove-store-record",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://ent-server.hostl.cloud/**" },
        { "url": "https://ent-location-sys.vercel.app/**" }
      ]
    }
  ]
}
