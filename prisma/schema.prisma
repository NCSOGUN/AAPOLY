// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facility {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  address           String?
  city              String?
  state             String    @default("Ogun")
  country           String    @default("Nigeria")
  latitude          Float
  longitude         Float
  phone             String?
  email             String?
  website           String?
  accredited        Boolean   @default(false)
  accreditationDate DateTime?
  operatingHours    Json?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  specialties FacilitySpecialty[]
  services    FacilityService[]
  users       HospitalUser[]
}

model Specialty {
  id          String  @id @default(cuid())
  name        String  @unique // e.g. "ENT", "Otology", "Rhinology"
  code        String? @unique
  description String?

  facilities FacilitySpecialty[]
}

model FacilitySpecialty {
  facilityId  String
  specialtyId String
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([facilityId, specialtyId])
}

model FacilityService {
  id         String   @id @default(cuid())
  facilityId String
  name       String // "Audiometry", "Nasal Endoscopy", "CT Scan"...
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hashed
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String                        // e.g. "Patient PWA", "Hospital Desktop"
  keyHash     String    @unique             // bcrypt hash of the actual key
  keyPrefix   String                        // non-secret prefix used to narrow key verification
  owner       String?                       // optional — team / app name
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([keyPrefix, active])
}

model EscalatedCase {
  id                String   @id @default(cuid())
  symptoms          String
  affectedArea      String?
  duration          String?
  age               Int?
  additionalContext String?
  analysisResult    Json
  imageUrls         String[]
  status            String   @default("pending") // pending | under_review | responded | closed
  consentGiven      Boolean  @default(false)
  patientEmail      String?
  specialistNotes   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Condition {
  id                    String   @id  // slug e.g. "otitis-media-acute"
  name                  String
  commonName            String
  category              String       // ear | nose | throat | head_neck | paediatric
  subcategory           String
  icdCode               String?
  description           String
  symptoms              Json         // { primary, secondary, rare }
  affectedAreas         String[]
  onsetPattern          String
  typicalDuration       String
  ageGroups             String[]
  riskFactors           String[]
  causes                Json         // { primary, contributing }
  redFlags              String[]
  diagnosticClues       String[]
  differentialDiagnosis String[]     // array of condition IDs
  investigations        Json         // { clinical, laboratory, imaging, specialist }
  treatment             Json         // { selfCare, medication, procedural, surgical }
  referralThreshold     String       // emergency | urgent_24h | urgent_week | routine | gp_only
  referralThresholdReason String
  specialistNeeded      String[]
  urgencyScore          Int
  urgencyRationale      String
  patientAdvice         String
  preventionTips        String[]
  complications         String[]
  relatedConditions     String[]     // array of condition IDs
  keywords              String[]
  nigeriaContext        Json         // { prevalence, localFactors, accessConsiderations }
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
  @@index([urgencyScore])
}

model HospitalUser {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String    // bcrypt hashed
  role            String    @default("doctor") // doctor | specialist | nurse | admin
  specialization  String?   // e.g. "Otologist", "Rhinologist"
  phone           String?
  licenseNumber   String?   // professional license/registration number
  facilityId      String?
  facility        Facility? @relation(fields: [facilityId], references: [id])
  accessToken     String    @unique
  tokenIssuedAt   DateTime  @default(now())
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Patient Profile (optional — created only if user chooses to save their info) ───

model PatientProfile {
  id              String    @id @default(cuid())

  // Identity — all optional
  firstName       String?
  lastName        String?
  email           String?               // for email-back of reports
  phone           String?
  dateOfBirth     DateTime?
  gender          String?               // male | female | other | prefer_not_to_say
  address         String?
  city            String?
  state           String?
  country         String?   @default("Nigeria")

  // Passport / profile photo — stored in iDrive E2
  passportPhotoKey  String?             // storage key e.g. "profiles/2026/xx/img_xx.jpg"
  passportPhotoUrl  String?             // signed URL (expires — refresh on demand)

  // Medical context
  bloodGroup        String?             // A+ | B+ | O+ etc.
  knownAllergies    String[]
  existingConditions String[]
  currentMedications String[]
  previousSurgeries  String[]
  emergencyContact   String?
  emergencyPhone     String?

  // Consent & preferences
  consentToDataRetention Boolean @default(false)   // agreed we can keep their data
  consentToContactByEmail Boolean @default(false)  // we can email them
  consentDate            DateTime?

  // Tracking
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  reports       DiagnosisReport[]

  @@index([email])
  @@index([phone])
}

// ─── Diagnosis Report — always created, optionally linked to a patient ───────────

model DiagnosisReport {
  id              String    @id @default(cuid())
  trackingId      String    @unique   // short human-readable: "ENT-2026-XXXXXX"

  // Input (what the user sent)
  symptoms        String
  affectedArea    String?
  duration        String?
  age             Int?
  additionalContext String?
  inputImageKeys  String[]            // iDrive E2 keys for uploaded images

  // Analysis result (full JSON from /api/v1/analyze response)
  analysisResult  Json

  // Clinical output (denormalised for quick access without parsing JSON)
  primaryConditionId   String?       // condition slug
  primaryConditionName String?
  urgencyScore         Int?
  urgencyLevel         String?       // Emergency | Urgent | Soon | Routine
  referralThreshold    String?

  // Location context
  latitude        Float?
  longitude       Float?
  place           String?

  // Nearby facilities snapshot (what was returned at time of report)
  nearbyFacilities Json?

  // PDF report
  pdfKey          String?             // iDrive E2 storage key when PDF generated
  pdfUrl          String?             // signed URL

  // Patient link — optional
  patientProfileId  String?
  patientProfile    PatientProfile? @relation(fields: [patientProfileId], references: [id])

  // Status
  status          String    @default("generated")  // generated | viewed | shared | archived

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([trackingId])
  @@index([patientProfileId])
  @@index([urgencyScore])
  @@index([createdAt])
  @@index([primaryConditionId])
}
